# --- 시스템 메시지 함수 (변화 없음) ---
function handleSystemMessages(s: number):
    if {_s} is 1:
        broadcastChat("30초 후 호텔, 묘지, 절에서 생명의 나무가 나타납니다.")
    else if {_s} is 2:
        broadcastChat("30초 후 숲, 개울에서 생명의 나무가 나타납니다.")
    else if {_s} is 3:
        sandimpactMassage()
    else if {_s} is 4:
        broadcastChat("호텔, 묘지, 절에서 생명의 나무가 나타났습니다.")
    else if {_s} is 5:
        broadcastChat("숲, 개울에서 생명의 나무가 나타났습니다.")
    else if {_s} is 6:
        center_annonce(" 30초 후 항공보급이 도착합니다.", 80, "")
    else if {_s} is 7:
        center_annonce(" 항공보급이 도착합니다.", 80, "minecraft:er.announce_air_supply_conduct")
    else if {_s} is 8:
        center_annonce(" 이제 키오스크를 사용할 수 있습니다.", 80, "")
    else if {_s} is 9:
        center_annonce(" 최종 금지 구역에서는 보안콘솔을 사용할 수 없습니다.", 80, "")
    else if {_s} is 101:
        startRandomTeleport()

every 1 tick:
    loop all players:
        # 플레이어의 스코어보드 태그 리스트를 가져와서 비어있지 않은지 확인
        set {_tags::*} to scoreboard tags of loop-player
        if size of {_tags::*} > 0:
            # 태그가 있을 때만 함수를 실행하고, 가져온 태그 리스트를 인자로 넘겨주면 더 빠릅니다.
            handleSystemTags(loop-player, {_tags::*})
            handleJumpPads(loop-player, {_tags::*})
            handleLoadingBars(loop-player, {_tags::*})

            
# --- 시스템 태그 처리 (contains 활용으로 루프 최소화) ---
function handleSystemTags(p: player, tags: texts):
    # 매개변수 명칭 수정: {_tags::*} -> {_tags} (선언된 이름 그대로 사용)
    # Skript에서 리스트 매개변수는 {_tags::*} 형식이 아니라 {_tags::*}로 불러오려면 
    # 호출할 때부터 리스트로 넘기거나, 함수 내부에서 적절히 처리해야 합니다.

    if {_tags::*} contains "bos.blackout":
        updateBossBar({_p}, 1, text component of "{text:""b"",font:""mono_color""}")
        remove "bos.blackout" from scoreboard tags of {_p}
        
    if {_tags::*} contains "bos.reset":
        manageAllBossBars({_p}, "delete")
        createBossBars({_p})
        remove "bos.reset" from scoreboard tags of {_p} # 리셋 태그도 지워줘야 무한루프 안 함
        
    if {_tags::*} contains "bos.clear":
        loop 6 times:
            updateBossBar({_p}, loop-number, text component of "{text:"" ""}")
        remove "bos.clear" from scoreboard tags of {_p}
        
    if {_tags::*} contains "show_map":
        updateBossBar({_p}, 6, {bossbar.list::map})
        remove "show_map" from scoreboard tags of {_p}
        
    if {_tags::*} contains "goto_lobby":
        remove "goto_lobby" from scoreboard tags of {_p}
        connect {_p} to proxy server "lobby"
    
    if {_tags::*} contains "bos.null5":
        updateBossBar({_p}, 5, text component of "{text:"" ""}")
        remove "bos.null5" from scoreboard tags of {_p}
        
    if {_tags::*} contains "bos.null2":
        updateBossBar({_p}, 2, text component of "{text:"" ""}")
        remove "bos.null2" from scoreboard tags of {_p}
    
    if {_tags::*} contains "selection_character":
        showLeftTimeInSelectCharacter({_p})
        updateBossBar({_p}, 2, {bossbar.list::%uuid of {_p}%})
        
    if {_tags::*} contains "bos.waitbar":
        updateWaitBossBar({_p})
        
    if {_tags::*} contains "bos.start":
        updateStartBossBar({_p})


# --- 점프패드 처리 (배열 루프 적용) ---
function handleJumpPads(p: player, tags: texts):
    loop {_tags::*}: # 지적하신 대로 배열로 처리
        if loop-value starts with "jump_":
            if loop-value is "jump_factory":
                setParabolicMotion({_p}, -532, 100, 380, 10)
            else if loop-value is "jump_harbor":
                setParabolicMotion({_p}, -471, 90, 351, 10)
            else if loop-value is "jump_residential_area":
                setParabolicMotion({_p}, -428, 100, 440, 10)
            else if loop-value is "jump_pondA_1":
                setParabolicMotion({_p}, -688, 90, 506, 10)
            else if loop-value is "jump_pondA_2":
                setParabolicMotion({_p}, -613, 90, 465, 10)
            else if loop-value is "jump_pondB_1":
                setParabolicMotion({_p}, -575, 93, 485, 10)
            else if loop-value is "jump_pondB_2":
                setParabolicMotion({_p}, -642, 100, 463, 10)
            
            remove loop-value from scoreboard tags of {_p}

# --- 로딩바 처리 (배열 루프 적용) ---
function handleLoadingBars(p: player, tags: texts):
    if {_tags::*} contains "show_cctv_loading":
        startLoadingBar({_p}, 60, "minecraft:er.cctv.acitving", "minecraft:er.cctv.success_active", "cctv_loading", "보안콘솔 작동 중")
        remove "show_cctv_loading" from scoreboard tags of {_p}
    else if {_tags::*} contains "show_hyperloop_loading":
        startLoadingBar({_p}, 60, "minecraft:er.hyper_loop.acitving", "minecraft:er.hyper_loop.warp", "", "하이퍼루프 가동 중")
        add "hyper_loop_activing" to scoreboard tags of {_p}
        remove "show_hyperloop_loading" from scoreboard tags of {_p}
    
    # 채집 관련 태그 루프 처리
    loop {_tags::*}:
        if loop-value starts with "show_":
            if loop-value is "show_meteorite_loading":
                startDoubleLoadingBar({_p}, 80, "minecraft:er.item.collect.meteorite", "", "colleting_meteorite", "운석 채집 중")
                add "colleting_meteorite" to scoreboard tags of {_p}
                remove "show_meteorite_loading" from scoreboard tags of {_p}
                remove "click_meteorite" from scoreboard tags of {_p}
            else if loop-value is "show_tree_loading":
                startDoubleLoadingBar({_p}, 80, "minecraft:er.item.collect.tree_of_life", "", "colleting_tree", "생명의 나무 채집 중")
                add "colleting_tree" to scoreboard tags of {_p}
                remove "show_tree_loading" from scoreboard tags of {_p}
                remove "click_tree" from scoreboard tags of {_p}
            # ... 다른 채집 도구들 동일하게 적용
            
            # 성능을 위해 해당 로직 처리 후 루프 종료
            stop loop
