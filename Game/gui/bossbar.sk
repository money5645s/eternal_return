function space(space: int) :: text components:
    set {_s} to translate component of "space.%{_space}%"
    return {_s}


command /투:
    trigger:
        set {_msg2} to mini message from "<font:haesu/8>이니다."

        set {_msg} to mini message from "<font:haesu/8>1234</font> <lang:space.0> <red>1234"
        setPlayerStateGUIJson(player)
        set {_t} to {stateGUI::%uuid of player%}
        updateBossBar(player, 6, {_t})

