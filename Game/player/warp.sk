# 2. 랜덤 텔레포트 함수
function startRandomTeleport():
    # 저장된 좌표 복사
    set {_temp_points::*} to {spawn_points::*}
    
    # 좌표 리스트를 랜덤하게 섞기
    set {_shuffled_points::*} to shuffled {_temp_points::*}
    
    set {_index} to 1
    loop all players:
        # 접속 중인 모든 플레이어에게 순서대로 섞인 좌표 부여
        if {_index} <= size of {_shuffled_points::*}:
            set {_target_loc} to {_shuffled_points::%{_index}%}
            
            # 텔레포트 실행
            teleport loop-player to {_target_loc}
            
            add 1 to {_index}
        else:
            stop loop
