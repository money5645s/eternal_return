# --- 보조 함수: 데이터를 변수에 저장 ---
function addRegion(name: string, x: number, y: number, z: number, dx: number, dy: number, dz: number):
    # 새로운 인덱스 생성
    add 1 to {RegionCount::%{_name}%}
    set {_i} to {RegionCount::%{_name}%}-1
    
    # x,y,z 지점과 x+dx, y+dy, z+dz 지점 저장
    set {Region::%{_name}%::%{_i}%::pos1} to location({_x}, {_y}, {_z}, world "overworld")
    set {Region::%{_name}%::%{_i}%::pos2} to location(({_x} + {_dx}), ({_y} + {_dy}), ({_z} + {_dz}), world "overworld")

# --- 핵심 함수: 현재 플레이어 위치의 구역 이름 반환 ---
function getPlayerRegion(p: player):
    set {_loc} to location of {_p}
    set {_x} to x-coordinate of {_loc}
    set {_z} to z-coordinate of {_loc}
    
    # 모든 구역 이름을 루프 (alley, school 등)
    loop {RegionCount::*}:
        set {_name} to loop-index
        set {_i} to {RegionCount::%{_name}%}

        # 각 구역 안에 설정된 모든 범위(point1, 2...)를 루프
        loop {_i} times:
            set {_pos1} to {Region::%{_name}%::%(loop-number)-1%::pos1}
            set {_p1x} to x-coordinate of {_pos1}
            set {_p1z} to z-coordinate of {_pos1}

            set {_pos2} to {Region::%{_name}%::%(loop-number)-1%::pos2}
            set {_p2x} to x-coordinate of {_pos2}
            set {_p2z} to z-coordinate of {_pos2}

            if {_x} is between {_p1x} and {_p2x}:
                if {_z} is between {_p1z} and {_p2z}:
                    set {inRegion::%{_p}%} to {_name}



function isChangedPlayerRegion(p:player):
    getPlayerRegion({_p})
    set {_CurrentRegion} to {inRegion::%{_p}%}
    set {_LastRegion} to {lastregion::%{_p}%}

    if {_CurrentRegion} is not {_LastRegion}:
        set {lastregion::%{_p}%} to {inRegion::%{_p}%}
        #send action bar convertZoneName({inRegion::%{_p}%}) to {_p}

function convertZoneName(name: string) :: string:
    if {_name} is "alley":
        return "골목길"
    else if {_name} is "archery_range":
        return "양궁장"
    else if {_name} is "police_station":
        return "경찰서"
    else if {_name} is "fire_station":
        return "소방서"
    else if {_name} is "temple":
        return "절"
    else if {_name} is "stream":
        return "개울"
    else if {_name} is "pond":
        return "연못"
    else if {_name} is "hospital":
        return "병원"
    else if {_name} is "cemetery":
        return "묘지"
    else if {_name} is "chapel":
        return "성당"
    else if {_name} is "factory":
        return "공장"
    else if {_name} is "dock":
        return "항구"
    else if {_name} is "warehouse":
        return "창고"
    else if {_name} is "uptown":
        return "고급 주택가"
    else if {_name} is "beach":
        return "모래사장"
    else if {_name} is "forest":
        return "숲"
    else if {_name} is "hotel":
        return "호텔"
    else if {_name} is "school":
        return "학교"
    else if {_name} is "gas_station":
        return "주유소"
    else if {_name} is "research_center":
        return "연구소"
    else if {_name} is "briefing_room":
        return "브리핑 룸"
    
    return "야생"

every 0.5 seconds:
    loop all players:
        isChangedPlayerRegion(loop-player)