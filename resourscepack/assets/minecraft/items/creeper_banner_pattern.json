{
	"model": {
	  "type": "minecraft:select",
	  "property": "minecraft:custom_model_data",
	  "fallback": {
		"type": "minecraft:model",
		"model": "minecraft:item/creeper_banner_pattern"
	  },
	  "cases": [

		{
			"when": "jumppad","model": {"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data",
			  "entries": [
				{"threshold": 0,"model": {"type": "minecraft:model","model": "map/jumppad/deactivate"}},
				{"threshold": 1,"model": {"type": "minecraft:model","model": "map/jumppad/1"}},
				{"threshold": 2,"model": {"type": "minecraft:model","model": "map/jumppad/2"}},
				{"threshold": 3,"model": {"type": "minecraft:model","model": "map/jumppad/3"}},
				{"threshold": 4,"model": {"type": "minecraft:model","model": "map/jumppad/4"}},
				{"threshold": 5,"model": {"type": "minecraft:model","model": "map/jumppad/5"}},
				{"threshold": 6,"model": {"type": "minecraft:model","model": "map/jumppad/6"}},
				{"threshold": 7,"model": {"type": "minecraft:model","model": "map/jumppad/7"}},
				{"threshold": 8,"model": {"type": "minecraft:model","model": "map/jumppad/8"}}
			  ]}},		
		{
				"when": "cctv","model": {"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data",
				  "entries": [
					{"threshold": 0,"model": {"type": "minecraft:model","model": "map/cctv/normal"}},
					{"threshold": 1,"model": {"type": "minecraft:model","model": "map/cctv/active"}},
					{"threshold": 2,"model": {"type": "minecraft:model","model": "map/cctv/active_locked"}},
					{"threshold": 3,"model": {"type": "minecraft:model","model": "map/cctv/system_offline"}}
				]}},
		{"when": "kiosk","model": {"type": "minecraft:model","model": "map/kiosk"}},
		{"when": "kiosk_off","model": {"type": "minecraft:model","model": "map/kiosk_off"}},
		{"when": "hyperloop","model": {"type": "minecraft:model","model": "map/hyperloop"}},
		{"when": "cobblestone","model": {"type": "minecraft:model","model": "map/cobblestone"}},
		{"when": "branch","model": {"type": "minecraft:model","model": "map/branch"}},
		{"when": "fishing_rod","model": {"type": "minecraft:model","model": "map/fishing_rod"}},
		{"when": "food_box","model": {"type": "minecraft:model","model": "map/food_box"}},
		{"when": "epic_box","model": {"type": "minecraft:model","model": "map/epic_box"}},
		{"when": "mythic_box","model": {"type": "minecraft:model","model": "map/mythic_box"}},
		{"when": "meteor_info","model": {"type": "minecraft:model","model": "map/meteor_info"}},
		{"when": "meteor_info_in","model": {"type": "minecraft:model","model": "map/meteor_info_in"}},
		{"when": "box_info","model": {"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data",
			  "entries": [
				{"threshold": 0,"model": {"type": "minecraft:model","model": "map/box_info"}},
				{"threshold": 1,"model": {"type": "minecraft:model","model": "map/box_info_rotate"}}
			]}}
	  ]
	}
}