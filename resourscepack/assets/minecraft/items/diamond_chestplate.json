{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/diamond_chestplate"
    },
    "cases": [
      {
        "when": "chestplate",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:custom_model_data",
          "entries": [
              {"threshold": 1, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/blood_sample_chestplate"}},
              {"threshold": 2, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/meteorite_chestplate"}},
              {"threshold": 3, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/mithril_chestplate"}},
              {"threshold": 4, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/tree_of_life_chestplate"}},
              {"threshold": 5, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/force_core_chestplate"}}

          ]
        }
      }
    ]
  }
}