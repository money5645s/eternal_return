{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/diamond_helmet"
    },
    "cases": [
      {
        "when": "helmet",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:custom_model_data",
          "entries": [
              {"threshold": 1, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/blood_sample_helmet"}},
              {"threshold": 2, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/meteorite_helmet"}},
              {"threshold": 3, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/mithril_helmet"}},
              {"threshold": 4, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/tree_of_life_helmet"}},
              {"threshold": 5, "model": {"type": "minecraft:model", "model": "minecraft:item/armor/force_core_helmet"}}

          ]
        }
      }
    ]
  }
}